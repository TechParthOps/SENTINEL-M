{
  "id": "WEB-XSS-001",
  "title": "Cross-site scripting indicators in request URI/query",
  "type": "pattern",
  "class": "web_resource_access_activity",
  "patterns": [
    {"field": "http_url", "regex": "(?i)(<script|%3cscript|javascript:|onerror\\s*=|onload\\s*=|document\\.cookie|alert\\s*\\(.{0,30}\\)|\\balert\\(\\s*[^)]*\\))"}
  ],
  "entity_field": "src_ip",
  "entity_type": "ip",
  "signature_field": "http_url",
  "cooldown_seconds": 1800,
  "severity_id": 4,
  "category": "web_attack",
  "attack_ids": ["T1190"],
  "attack_tactics": ["Initial Access"],
  "message_template": "XSS pattern from {entity}: {match}",
  "status": "stable",
  "source": "SENTINEL-M deterministic rule (Phase 2)",
  "notes": "Attempt indicator from logs only; a WAF/browser CSP blocks exploitation, this rule only reports the attempt."
}