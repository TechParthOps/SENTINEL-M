{
  "id": "WEB-SSRF-001",
  "title": "Server-side request forgery indicators (internal/metadata targets)",
  "type": "pattern",
  "class": "web_resource_access_activity",
  "patterns": [
    {"field": "http_url", "regex": "(?i)(169\\.254\\.169\\.254|metadata\\.google\\.internal|127\\.0\\.0\\.1[:/]|localhost[:/]|0\\.0\\.0\\.0[:/]|\\[::1\\][:/]|10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3})"}
  ],
  "entity_field": "src_ip",
  "entity_type": "ip",
  "signature_field": "http_url",
  "cooldown_seconds": 1800,
  "severity_id": 4,
  "category": "web_attack",
  "attack_ids": ["T1190"],
  "attack_tactics": ["Initial Access"],
  "message_template": "SSRF pattern from {entity}: {match}",
  "status": "experimental",
  "source": "SENTINEL-M deterministic rule (Phase 2)",
  "notes": "Any URL parameter containing internal/metadata endpoints. High false-positive potential for internal tooling — validate with the application owner."
}