{
  "id": "HOST-REGISTRY-PERSIST-001",
  "title": "Registry Run key modification (autostart persistence)",
  "type": "pattern",
  "class": "process_activity",
  "patterns": [
    {"field": "command_line", "regex": "(?i)(reg(\\.exe)?\\s+add.{0,120}(currentversion\\\\run|runonce| wow6432node.{0,40}run))"}
