# SENTINEL-M configuration template. Copy to `backend/.env` and fill in.
# All variables use the SENTINEL_ prefix (ADR-001). Commands run from backend/.

# REQUIRED for any real use — JWT signing key (any long random string).
SENTINEL_SECRET_KEY=

# First-boot admin password. Only used when the database has no users yet;
# if empty, a random password is generated and printed ONCE in the startup log.
SENTINEL_SEED_ADMIN_PASSWORD=

# Database location (default: backend/data/sentinel.db).
# SENTINEL_DB_URL=sqlite:///E:/SENTINEL-M/backend/data/sentinel.db

# Deception isolation: honeypot listeners bind here (loopback default — do not
# expose to untrusted networks without reviewing app/deception/engine.py).
SENTINEL_DECEPTION_BIND=127.0.0.1

# Emergency stop: false disables all real response actions (approval still works;
# execution is rejected).
SENTINEL_RESPONSE_ENABLED=true

# Non-admin self-registration (viewer/analyst only; admins always require an admin token).
SENTINEL_ALLOW_SELF_REGISTRATION=true

# Optional ingest token for telemetry collectors (X-Ingest-Token header).
# SENTINEL_INGEST_TOKEN=