# SENTINEL-M backend configuration (copy to .env and edit)
# All variables use the SENTINEL_ prefix.

# REQUIRED in any real deployment. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_SECRET_KEY=change-me-generate-a-real-key

# Database (SQLAlchemy URL). Default: sqlite under backend/data/
# Production target (Phase 7+): postgresql+psycopg://user:pass@host:5432/sentinel
#SENTINEL_DB_URL=sqlite:///E:/SENTINEL-M/backend/data/sentinel.db

# JWT lifetime in minutes (default 480 = 8h)
#SENTINEL_TOKEN_TTL_MINUTES=480

# Simple in-memory rate limiting for auth + ingestion endpoints
#SENTINEL_RATELIMIT_ENABLED=true

# Optional shared token for telemetry agents (X-Ingest-Token header). Empty = JWT auth only.
#SENTINEL_INGEST_TOKEN=

# If set, the seeded initial admin gets this password instead of a generated one (used by installer/smoke tests)
#SENTINEL_SEED_ADMIN_PASSWORD=
